@startuml
'==============================================================
' DESIGN SET DS5 - Member Engagement and Analytics
' Sequence: The member tracks the workouts, the streak and the leaderboard
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS5 - Track the workouts, the streak and the leaderboard\n(Sequence Diagram)

participant "Member" as Member
participant "Tracking Page\n(React)" as Page
participant "MemberTrackingController" as TrkCtl
participant "MemberTrackingService" as TrkSvc
participant "MemberTrackingRepository" as TrkRepo
participant "DayStreakController" as StreakCtl
participant "DayStreakService" as StreakSvc
participant "DayStreakRepository" as StreakRepo
participant "LeaderboardController" as LbCtl
participant "WeeklyLeaderboardService" as LbSvc
participant "MemberWeeklyScoreRepository" as ScoreRepo
participant "MySQL\n(Database)" as DB

== READ THE OVERVIEW AND RECORD THE MEASUREMENTS ==

Member -> Page : Open the health tracking overview
Page -> TrkCtl : Get the health tracking overview
TrkCtl -> TrkSvc : Get the health tracking overview
TrkSvc -> TrkRepo : Load the measurements and the workouts of the member
TrkRepo -> DB : run the query
DB --> TrkRepo : the matching rows
TrkRepo --> TrkSvc : the tracking data
TrkSvc --> TrkCtl : HealthTrackingOverviewResponse(overview)
TrkCtl --> Page : Show the overview

Member -> Page : Enter the weight and the body measurements
Page -> TrkCtl : Record the body measurements
TrkCtl -> TrkSvc : Record the body measurements
TrkSvc -> TrkRepo : Save the measurements of the member
TrkRepo -> DB : run the query
DB --> TrkRepo : the matching rows
TrkSvc --> TrkCtl : the updated measurements
TrkCtl --> Page : Show the new measurements

== READ THE WORKOUT HISTORY ==

Member -> Page : Open the workout history
Page -> TrkCtl : Get the workout history
TrkCtl -> TrkSvc : Get the workout history
TrkSvc -> TrkRepo : Load the workout sessions of the member
TrkRepo -> DB : run the query
DB --> TrkRepo : the matching rows
TrkRepo --> TrkSvc : the session list
TrkSvc --> TrkCtl : WorkoutHistoryResponse(sessions)
TrkCtl --> Page : Show the workout history

== READ THE DAY STREAK AND THE DAY REPORT ==

Member -> Page : Open the streak panel
Page -> StreakCtl : Get the day streak of the month
StreakCtl -> StreakSvc : Get the day streak of the month
StreakSvc -> StreakRepo : Load the streak days of the member
StreakRepo -> DB : run the query
DB --> StreakRepo : the matching rows
StreakRepo --> StreakSvc : the streak days
StreakSvc --> StreakCtl : DayStreakResponse(current, longest)
StreakCtl --> Page : Show the streak

Member -> Page : Open the report of today
Page -> StreakCtl : Get the day report
StreakCtl -> StreakSvc : Get the day report
StreakSvc -> StreakRepo : Load the workouts and the goals of the day
StreakRepo -> DB : run the query
DB --> StreakRepo : the matching rows
StreakRepo --> StreakSvc : the day data
StreakSvc --> StreakCtl : DayReportResponse(report)
StreakCtl --> Page : Show the day report

== READ THE WEEKLY LEADERBOARD ==

Member -> Page : Open the leaderboard
Page -> LbCtl : Get the weekly leaderboard
LbCtl -> LbSvc : Get the weekly leaderboard
LbSvc -> ScoreRepo : Load the weekly scores of the members
ScoreRepo -> DB : run the query
DB --> ScoreRepo : the matching rows
ScoreRepo --> LbSvc : the score list
LbSvc --> LbCtl : the leaderboard with the rank of the member
LbCtl --> Page : Show the leaderboard

@enduml
