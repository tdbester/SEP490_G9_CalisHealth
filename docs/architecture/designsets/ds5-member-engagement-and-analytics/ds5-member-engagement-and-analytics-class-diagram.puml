@startuml
left to right direction
'==============================================================
' DESIGN SET DS5 - Member Engagement and Analytics
' Class Diagram: Controller -> Service -> DTO -> DAO -> Entity
'
' UML notation - exactly the six symbols of the project reference:
'   --      Association            solid line, no head
'   --|>    Generalization          solid line, hollow triangle
'   ..|>    Realization             dashed line, hollow triangle
'   ..>     Dependency              dashed line, OPEN arrow head
'   o--     Aggregation             solid line, hollow diamond
'   *--     Composition             solid line, filled diamond
'==============================================================
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam arrowThickness 1.2
skinparam defaultLineThickness 1.2
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam class {
  BorderThickness 1.2
  BackgroundColor #FFFFFF
  FontColor #000000
  AttributeFontColor #1F3864
  MethodFontColor #7B3F00
}
skinparam package {
  BorderThickness 1.2
  FontStyle bold
  FontSize 11
  BackColor #E4E4E4
}
skinparam stereotype {
  FontSize 8
  FontStyle italic
}

title DESIGN SET DS5 - Member Engagement and Analytics\n(Class Diagram)

'==============================================================
' CONTROLLER
'==============================================================
package "Controller" as CTL {
  class MemberScheduleController <<Controller>> {
    - scheduleService : MemberScheduleService
    --
    + availableWorkouts(Authentication authentication) : List<AvailableWorkoutResponse>
    + planInfo(Authentication authentication) : PlanInfoResponse
    + weekRule(Authentication authentication) : WeekRuleResponse
    + saveWeek(SaveWeekRequest request, Authentication authentication) : MemberScheduleResponse
    + save(SaveScheduleRequest request, Authentication authentication) : MemberScheduleResponse
    + current(Authentication authentication) : MemberScheduleResponse
    + byMonth(LocalDate month, Authentication authentication) : MemberScheduleResponse
    + today(LocalDate date, Authentication authentication) : List<TodayWorkoutResponse>
    + all(Authentication authentication) : List<MemberScheduleResponse>
    + updateStatus(LocalDate date, String status, Authentication authentication) : MemberScheduleResponse
  }

  class MemberTrackingController <<Controller>> {
    - trackingService : MemberTrackingService
    --
    + getOverview(Authentication authentication) : HealthTrackingOverviewResponse
    + updateMeasurements(Authentication authentication, UpdateMeasurementsRequest request) : BodyMetricsDto
    + getWorkoutHistory(Authentication authentication, String category, LocalDate date) : WorkoutHistoryResponse
    + getWorkoutSessionDetail(Authentication authentication, Long sessionId) : WorkoutSessionDetailResponse
    + getAnalytics(Authentication authentication, String range) : PerformanceAnalyticsResponse
  }

  class DayStreakController <<Controller>> {
    - dayStreaks : DayStreakService
    --
    + getDayStreak(Authentication authentication, int year, int month) : DayStreakResponse
    + getDayReport(Authentication authentication, LocalDate date) : DayReportResponse
  }

  class DashboardController <<Controller>> {
    - dashboardService : DashboardService
    --
    + getDashboard(Authentication authentication) : ObjectNode
  }

  class LeaderboardController <<Controller>> {
    - scoreRepository : MemberWeeklyScoreRepository
    - memberProfileRepository : MemberProfileRepository
    - leaderboardService : WeeklyLeaderboardService
    --
    + getCurrentWeekLeaderboard(Long levelId, Authentication authentication) : ResponseEntity<LeaderboardResponse>
    + getMemberWeekHistory(Long memberId) : ResponseEntity<MemberWeekHistoryResponse>
    + getScoreBreakdown(Long memberId, LocalDate weekStart) : ResponseEntity<ScoreBreakdownResponse>
    + computeWeeklyScores(LocalDate weekStart) : ResponseEntity<Map<String, String>>
  }

  class MemberNotificationController <<Controller>> {
    - notifications : MemberNotificationService
    --
    + getNotifications(Authentication authentication) : ResponseEntity<MemberNotificationListDto>
    + markAsRead(Long id, Authentication authentication) : ResponseEntity<Void>
  }

  class MemberFeedbackController <<Controller>> {
    - feedbackService : MemberFeedbackService
    --
    + listMine(Authentication authentication) : ResponseEntity<List<FeedbackResponse>>
    + create(CreateFeedbackRequest request, Authentication authentication) : ResponseEntity<FeedbackResponse>
  }
}

'==============================================================
' SERVICE
'==============================================================
package "Service" as SVC {
  class MemberScheduleService <<Service>> {
    - schedules : MemberScheduleRepository
    - workouts : WorkoutRepository
    - templates : DailyPlanTemplateRepository
    - profiles : MemberProfileRepository
    - users : UserRepository
    --
    + availableWorkouts(String email) : List<AvailableWorkoutResponse>
    + planInfo(String email) : Optional<PlanInfoResponse>
    + weekRule(String email) : WeekRuleResponse
    + saveWeek(String email, SaveWeekRequest request) : MemberScheduleResponse
    + save(String email, SaveScheduleRequest request) : MemberScheduleResponse
    + monthSchedule(String email, LocalDate monthDate) : Optional<MemberScheduleResponse>
    + currentSchedule(String email) : Optional<MemberScheduleResponse>
    + allSchedules(String email) : List<MemberScheduleResponse>
    + updateStatus(String email, LocalDate date, String status) : MemberScheduleResponse
    + todayWorkouts(String email, LocalDate date) : List<TodayWorkoutResponse>
  }

  class MemberTrackingService <<Service>> {
    - trackingRepository : MemberTrackingRepository
    --
    + getOverview(String email) : HealthTrackingOverviewResponse
    + recordMeasurements(String email, UpdateMeasurementsRequest request) : BodyMetricsDto
    + getWorkoutHistory(String email, String category, LocalDate date) : WorkoutHistoryResponse
    + getWorkoutSessionDetail(String email, Long sessionId) : WorkoutSessionDetailResponse
    + getPerformanceAnalytics(String email, String range) : PerformanceAnalyticsResponse
    + calculateBmi(BigDecimal weightKg, BigDecimal heightCm) : BigDecimal
  }

  class DayStreakService <<Service>> {
    - dayStreaks : DayStreakRepository
    --
    + getDayStreak(String email, int year, int month) : DayStreakResponse
    + getDayReport(String email, LocalDate date) : DayReportResponse
  }

  class DashboardService <<Service>> {
    - jdbcTemplate : JdbcTemplate
    - muscleGroupStatsService : MuscleGroupStatsService
    - jsonMapper : JsonMapper
    --
    + getDashboard(String email) : ObjectNode
  }

  class MuscleGroupStatsService <<Service>> {
    - jdbcTemplate : JdbcTemplate
    --
    + findAll() : List<MuscleGroupStat>
  }

  class WeeklyLeaderboardService <<Service>> {
    - scoreRepository : MemberWeeklyScoreRepository
    - memberProfileRepository : MemberProfileRepository
    - scoring : LeaderboardScoringRepository
    --
    + computeScoresForWeek(LocalDate weekStart) : void
    + refreshMemberScore(Long memberProfileId) : void
    + resetAndRecomputeMemberScore(Long memberProfileId) : void
    + explainScore(Long memberProfileId, LocalDate weekStart) : Map<String, BigDecimal>
  }

  class MemberNotificationService <<Service>> {
    - notifications : NotificationRepository
    - reads : NotificationReadRepository
    - users : UserRepository
    --
    + getNotifications(String memberEmail) : MemberNotificationListDto
    + markAsRead(Long notificationId, String memberEmail) : void
  }

  class MemberFeedbackService <<Service>> {
    - feedbacks : MemberFeedbackRepository
    - users : UserRepository
    - notifications : NotificationRepository
    --
    + create(String memberEmail, CreateFeedbackRequest request) : FeedbackResponse
    + listMine(String memberEmail) : List<FeedbackResponse>
    + listForContentManager(MemberFeedback.Status status, MemberFeedback.Category category, String search, LocalDate fromDate, LocalDate toDate) : FeedbackListResponse
    + detailForContentManager(Long feedbackId) : FeedbackResponse
    + takeInReview(String handlerEmail, Long feedbackId) : FeedbackResponse
    + handleByContentManager(String handlerEmail, Long feedbackId, HandleFeedbackRequest request) : FeedbackResponse
    + listForAdmin(MemberFeedback.Status status, MemberFeedback.Category category, String search, LocalDate fromDate, LocalDate toDate) : FeedbackListResponse
    + detailForAdmin(Long feedbackId) : FeedbackResponse
    + handleByAdmin(String adminEmail, Long feedbackId, HandleFeedbackRequest request) : FeedbackResponse
  }
}

'==============================================================
' DTO
'==============================================================
package "DTO" as DTO {
  class MemberScheduleDtos <<DTO>> {
    + ScheduleEntryRequest
    + SaveScheduleRequest
    + ScheduleEntryResponse
    + MemberScheduleResponse
    + AvailableWorkoutResponse
    + PlanInfoResponse
    + PlanDayResponse
    + WeekRuleResponse
    + SaveWeekRequest
    + TodayExerciseResponse
    + TodayWorkoutResponse
  }

  class MemberTrackingDtos <<DTO>> {
    + UpdateMeasurementsRequest
    + HealthTrackingOverviewResponse
    + HealthScoreDto
    + BodyMetricsDto
    + BmiOverviewDto
    + BmiMonthRecordDto
    + WorkoutHistoryResponse
    + WorkoutHistorySummaryDto
    + WorkoutSessionSummaryDto
    + WorkoutSessionDetailResponse
    + ExerciseDetailDto
    + PerformanceAnalyticsResponse
    + RepsSummaryDto
    + HoldSummaryDto
    + VolumeProgressionDto
    + DurationBreakdownDto
    + AiInsightDto
  }

  class DayStreakDtos <<DTO>> {
    + DayStreakResponse
    + WeeklyGoalResponse
    + DayReportResponse
    + ExerciseReportResponse
  }

  class MemberNotificationDto <<DTO>> {
    + id : Long
    + title : String
    + message : String
    + type : String
    + createdAt : LocalDateTime
    + read : boolean
  }

  class MemberNotificationListDto <<DTO>> {
    + items : List<MemberNotificationDto>
    + unreadCount : int
  }

  class MemberFeedbackDtos <<DTO>> {
    + CreateFeedbackRequest
    + FeedbackResponse
    + HandleFeedbackRequest
