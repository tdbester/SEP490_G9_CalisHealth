@startuml
'==============================================================
' DESIGN SET DS5 - Member Engagement and Analytics
' Sequence: The member builds the weekly schedule
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS5 - Build the weekly schedule\n(Sequence Diagram)

participant "Member" as Member
participant "Schedule Page\n(React)" as Page
participant "MemberScheduleController" as Ctl
participant "MemberScheduleService" as Svc
participant "MemberScheduleRepository" as SchedRepo
participant "WorkoutRepository" as WoRepo
participant "DailyPlanTemplateRepository" as TplRepo
participant "MySQL\n(Database)" as DB

== SEE THE AVAILABLE WORKOUTS AND THE PLAN ==

Member -> Page : Open the weekly schedule
Page -> Ctl : Get the workouts available for scheduling
Ctl -> Svc : Get the workouts available for scheduling
Svc -> WoRepo : Load the workouts of the catalog
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
WoRepo --> Svc : the workout list
Svc --> Ctl : the available workouts
Ctl --> Page : Show the available workouts

Page -> Ctl : Get the plan info of the member
Ctl -> Svc : Get the plan info of the member
Svc -> TplRepo : Load the daily plan template of the member
TplRepo -> DB : run the query
DB --> TplRepo : the matching rows
TplRepo --> Svc : the plan template
Svc --> Ctl : the plan info
Ctl --> Page : Show the plan of the member

== SAVE THE WEEK SCHEDULE ==

Member -> Page : Drag the workouts into the days and save
Page -> Ctl : Save the week schedule
Ctl -> Svc : Save the week schedule
Svc -> SchedRepo : Save the schedule entries of the week
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
SchedRepo --> Svc : the saved schedule
Svc --> Ctl : MemberScheduleResponse(schedule)
Ctl --> Page : Show the saved schedule

== SEE TODAY AND CHANGE A STATUS ==

Member -> Page : Open the schedule of today
Page -> Ctl : Get the workouts of today
Ctl -> Svc : Get the workouts of today
Svc -> SchedRepo : Load the entries of today
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
SchedRepo --> Svc : the entries of today
Svc --> Ctl : the today workouts
Ctl --> Page : Show the workouts of today

Member -> Page : Mark a workout as done or skipped
Page -> Ctl : Change the status of the entry
Ctl -> Svc : Change the status of the entry
Svc -> SchedRepo : Update the status of the entry
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
Svc --> Ctl : MemberScheduleResponse(schedule)
Ctl --> Page : Show the new status

@enduml
