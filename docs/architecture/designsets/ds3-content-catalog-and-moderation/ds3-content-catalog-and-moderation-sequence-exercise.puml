@startuml
'==============================================================
' DESIGN SET DS3 - Content Catalog and Moderation
' Sequence: The content manager manages the exercise catalog
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS3 - Manage the exercise catalog\n(Sequence Diagram - Content Manager)

participant "Content Manager" as CM
participant "Exercise Page\n(React)" as Page
participant "ExerciseController" as Ctl
participant "ExerciseService" as Svc
participant "ExerciseRepository" as ExRepo
participant "ExerciseVideoStorageService" as VideoSvc
participant "ContentModerationService" as ModSvc
participant "ExerciseModerationHistoryRepository" as HistRepo
participant "MySQL\n(Database)" as DB

== LIST AND OPEN AN EXERCISE ==

CM -> Page : Open the exercise catalog
Page -> Ctl : List the system exercises with the filters
Ctl -> Svc : List the system exercises with the filters
Svc -> ExRepo : Load the exercises of the page
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
ExRepo --> Svc : the exercise list
Svc --> Ctl : the paged exercise list
Ctl --> Page : Show the exercise catalog

CM -> Page : Open the detail of an exercise
Page -> Ctl : Get the detail of the exercise
Ctl -> Svc : Get the detail of the exercise
Svc -> ExRepo : Load the exercise with its media
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
ExRepo --> Svc : the exercise detail
Svc --> Ctl : SystemExerciseDetailResponseDTO(exercise)
Ctl --> Page : Show the detail of the exercise

== CREATE A SYSTEM EXERCISE ==

CM -> Page : Fill in a new exercise and save it
Page -> Ctl : Create the system exercise
Ctl -> Svc : Create the system exercise
Svc -> ModSvc : Check the title, the description and the guide steps
ModSvc --> Svc : the flagged words or nothing
Svc -> VideoSvc : Validate and store the demonstration video
VideoSvc --> Svc : the URL of the stored video
Svc -> ExRepo : Save the exercise
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
Svc --> Ctl : ExerciseResponse(exercise)
Ctl --> Page : Show the new exercise

== MODERATE AN EXERCISE ==

CM -> Page : Accept or reject an exercise
Page -> Ctl : Change the status of the exercise
Ctl -> Svc : Change the status of the exercise
Svc -> ExRepo : Update the status of the exercise
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
Svc -> HistRepo : Record the moderation decision
HistRepo -> DB : run the query
DB --> HistRepo : the matching rows
Svc --> Ctl : ExerciseResponse(exercise)
Ctl --> Page : Show the new status and refresh the list

CM -> Page : Open the approval history
Page -> Ctl : List the moderation history
Ctl -> Svc : Find the approval history
Svc -> HistRepo : Load the moderation history
HistRepo -> DB : run the query
DB --> HistRepo : the matching rows
HistRepo --> Svc : the history entries
Svc --> Ctl : the history list
Ctl --> Page : Show the moderation history

@enduml
