  class WorkoutExerciseItem <<Embeddable>> {
    - exercise : Exercise <<FK, PK>>
    - sets : int
    - reps : Integer
    - durationSeconds : Integer
    - restSeconds : int
  }

  class WorkoutPlanItem <<Embeddable>> {
    - workout : WorkoutEntry <<FK, PK>>
    - exercise : Exercise <<FK>>
    - dayOfWeek : int
    - beginnerSets : int
    - beginnerReps : int
    - intermediateSets : int
    - intermediateReps : int
    - advancedSets : int
    - advancedReps : int
  }

  class MemberFavorite <<Entity>> {
    - id : Long <<PK>>
    - memberId : Long
    - itemType : ItemType
    - itemId : Long
    - createdAt : LocalDateTime
  }

  class MediaFile <<Entity>> {
    - id : Long <<PK>>
    - fileUrl : String
    - originalName : String
    - fileType : String
    - format : String
    - sizeMb : BigDecimal
    - sizeBytes : long
    - durationSeconds : Integer
    - category : String
    - source : String
    - contentHash : String
    - status : String
    - previousStatus : String
    - reason : String
    - uploadedAt : LocalDateTime
    - uploadedBy : User <<FK>>
    - inactiveSince : LocalDateTime
    - deletableAt : LocalDateTime
    - trashedAt : LocalDateTime
    - trashedBy : User <<FK>>
    - purgeAt : LocalDateTime
    - purgedAt : LocalDateTime
  }

  class StorageSettings <<Entity>> {
    - id : Integer <<PK>>
    - maxVideoMb : int
    - maxImageMb : int
    - videoFormats : String
    - imageFormats : String
    - demoMaxSeconds : int
    - memberQuotaMb : int
    - uploadsPerDay : int
    - rejectedRetentionDays : int
    - orphanGraceHours : int
    - trashRetentionDays : int
    - restoreGraceDays : int
    - autoCleanupEnabled : boolean
    - creditGuardEnabled : boolean
    - creditGuardThreshold : int
    - quotaGb : int
    - warningPercent : int
    - criticalPercent : int
    - lastCleanupAt : LocalDateTime
    - lastCleanupFreedBytes : long
    - updatedBy : User <<FK>>
    - updatedAt : LocalDateTime
  }

  class User <<Entity>> {
    - id : Long <<PK>>
    - email : String <<UK>>
    - fullName : String
    - role : UserRole
    - blocked : boolean
  }

  class FitnessLevel <<Entity>> {
    - id : Long <<PK>>
    - name : String <<UK>>
    - scoreMin : int
    - scoreMax : int
  }

  class MemberProfile <<Entity>> {
    - id : Long <<PK>>
    - user : User <<FK, unique>>
    - fitnessLevel : FitnessLevel <<FK>>
  }

  class MemberSkillProgress <<Entity>> {
    - id : Long <<PK>>
    - status : String
    - bestReps : Integer
    - bestAccuracy : BigDecimal
    - unlockedAt : LocalDateTime
    - exercise : Exercise <<FK>>
    - memberProfile : MemberProfile <<FK>>
  }
}

