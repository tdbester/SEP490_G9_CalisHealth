@startuml
'==============================================================
' DESIGN SET DS3 - Content Catalog and Moderation
' Sequence: The content manager manages the workout templates
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS3 - Manage the workout templates\n(Sequence Diagram - Content Manager)

participant "Content Manager" as CM
participant "Workout Page\n(React)" as Page
participant "WorkoutController" as Ctl
participant "WorkoutService" as Svc
participant "LibraryWorkoutController" as LwCtl
participant "LibraryWorkoutService" as LwSvc
participant "ContentNameGuardService" as NameGuard
participant "WorkoutRepository" as WoRepo
participant "ExerciseRepository" as ExRepo
participant "MySQL\n(Database)" as DB

== LIST AND OPEN A WORKOUT ==

CM -> Page : Open the workout template list
Page -> Ctl : List the workout templates
Ctl -> Svc : Find all the workout templates
Svc -> WoRepo : Load the workout templates
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
WoRepo --> Svc : the template list
Svc --> Ctl : the template list
Ctl --> Page : Show the workout templates

CM -> Page : Open the detail of a workout
Page -> Ctl : Get the workout by its code
Ctl -> Svc : Find the workout by its code
Svc -> WoRepo : Load the workout with its exercises
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
WoRepo --> Svc : the workout detail
Svc --> Ctl : WorkoutResponse(workout)
Ctl --> Page : Show the detail of the workout

== CREATE AND QUICK UPDATE A WORKOUT ==

CM -> Page : Build a new workout and save it
Page -> Ctl : Create the workout template
Ctl -> Svc : Create the workout template
Svc -> NameGuard : Check that the name is not used yet
NameGuard --> Svc : the name is free or not
Svc -> ExRepo : Check that the referenced exercises exist
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
Svc -> WoRepo : Save the workout with its exercises
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
Svc --> Ctl : WorkoutResponse(workout)
Ctl --> Page : Show the new workout

CM -> Page : Change the name, the description or the exercises
Page -> Ctl : Quick update the workout
Ctl -> Svc : Quick update the workout
Svc -> WoRepo : Save the changed workout
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
Svc --> Ctl : WorkoutResponse(workout)
Ctl --> Page : Show the updated workout

== PUBLISH, HIDE AND DELETE A WORKOUT ==

CM -> Page : Publish, hide or delete a workout
Page -> Ctl : Change the status / delete the workout
Ctl -> Svc : Change the status / delete the workout
Svc -> WoRepo : Update the status / remove the workout
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
Svc --> Ctl : The workout has been changed
Ctl --> Page : Show the result and refresh the list

== CLONE A TEMPLATE INTO THE MEMBER LIBRARY ==

CM -> Page : Clone a system template for a member
Page -> LwCtl : Clone the template into a personal workout
LwCtl -> LwSvc : Clone the template into a personal workout
LwSvc -> ExRepo : Load the exercises of the template
ExRepo -> DB : run the query
DB --> ExRepo : the matching rows
LwSvc -> WoRepo : Save the copy as a personal workout
WoRepo -> DB : run the query
DB --> WoRepo : the matching rows
LwSvc --> LwCtl : WorkoutResponse(the personal workout)
LwCtl --> Page : Show the cloned personal workout

@enduml
