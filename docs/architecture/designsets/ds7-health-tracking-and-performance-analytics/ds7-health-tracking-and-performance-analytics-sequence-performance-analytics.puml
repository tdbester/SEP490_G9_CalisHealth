@startuml
'==============================================================
' DESIGN SET DS7 - Health Tracking & Performance Analytics
' Sequence 3 of 3: View performance analytics
'
' Front end : client/src/pages/PerformanceAnalytics.jsx  
'            client/src/components/common/BarChart.jsx
'            client/src/api/tracking.js
' Back end  : MemberTrackingController -> MemberTrackingService
'            -> MemberTrackingRepository -> MySQL
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS7 - View performance analytics\n(Sequence Diagram)

participant "Member" as User
participant "Performance Analytics Page\n(React)" as Page
participant "BarChart\n(React)" as Chart
participant "trackingApi\n(tracking.js)" as Api
participant "MemberTrackingController" as Ctl
participant "MemberTrackingService" as Svc
participant "MemberTrackingRepository" as Repo
participant "MySQL\n(Database)" as DB

== READ THE ANALYTICS OF THE LAST MONTH ==

User -> Page : Open the performance analytics screen
Page -> Api : Ask for the analytics of the last month
Api -> Ctl : Read the performance analytics of the signed-in member
Ctl -> Svc : Read the performance analytics
Svc -> Svc : Normalise the selected range\n(1M, 3M or 1Y - the last month by default)
Svc -> Repo : Look up the member profile by email address
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the member profile id
Svc -> Repo : Load the clean reps of the member
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the clean rep ratio
Svc -> Repo : Load the hold summary of the member
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the hold entries, the hold time and the form score
Svc -> Repo : Load the volume of every bucket of the range
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the reps and the hold seconds of every bucket
Svc -> Repo : Load the time split of the sessions
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the total time, the active time and the rest time
Svc -> Svc : Write the short insight from the measured numbers
Svc --> Ctl : PerformanceAnalyticsResponse\n(range, sessions, reps, hold, volume, duration, insight)
Ctl --> Api : the analytics
Api --> Page : the analytics data
Page -> Chart : Draw the volume chart\n(the reps or the hold seconds per bucket)
Chart --> Page : the drawn chart
Page -> Page : Draw the three range tabs, the clean rep ring,\nthe hold card and the duration split
Page --> User : Show the clean rep ratio, the hold summary,\nthe volume progression and the time split

== SWITCH THE TIME RANGE ==

User -> Page : Click on the "3M" tab
Page -> Api : Ask for the analytics of the last 3 months
Api -> Ctl : Read the performance analytics of the signed-in member
Ctl -> Svc : Read the performance analytics
Svc -> Repo : Load the analytics of the member for the last 3 months
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the analytics of the range
Svc --> Ctl : PerformanceAnalyticsResponse(range, ...)
Ctl --> Api : the analytics
Api --> Page : the analytics of the new range
Page -> Page : Redraw the volume chart\n(3 months instead of 4 weeks)

User -> Page : Click on the "1Y" tab
Page -> Api : Ask for the analytics of the last year
Api -> Ctl : Read the performance analytics of the signed-in member
Ctl -> Svc : Read the performance analytics
Svc -> Repo : Load the analytics of the member for the last 4 quarters
Repo -> DB : run the query
DB --> Repo : the matching rows
Repo --> Svc : the analytics of the range
Svc --> Ctl : PerformanceAnalyticsResponse(range, ...)
Ctl --> Api : the analytics
Api --> Page : the analytics of the new range
Page -> Chart : Redraw the volume chart\n(4 quarters instead of 4 weeks)
Chart --> Page : the drawn chart
Page --> User : Show the analytics of the last year

@enduml
