@startuml
'==============================================================
' DESIGN SET DS6 - Platform Administration and Operations
' Sequence: The admin manages the users and the maintenance windows
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS6 - Manage the users and the maintenance windows\n(Sequence Diagram - Admin)

participant "Admin" as Admin
participant "Admin Page\n(React)" as Page
participant "AdminUserController" as UserCtl
participant "AdminUserService" as UserSvc
participant "UserRepository" as UserRepo
participant "UserActivityRepository" as Activity
participant "AdminMaintenanceScheduleController" as MtCtl
participant "MaintenanceScheduleService" as MtSvc
participant "MaintenanceAreaLockService" as LockSvc
participant "MaintenanceScheduleRepository" as SchedRepo
participant "MySQL\n(Database)" as DB

== MANAGE THE USERS ==

Admin -> Page : Open the user list
Page -> UserCtl : List the users with the filters
UserCtl -> UserSvc : List the users with the filters
UserSvc -> UserRepo : Load the users of the page
UserRepo -> DB : run the query
DB --> UserRepo : the matching rows
UserRepo --> UserSvc : the user list
UserSvc --> UserCtl : UserPage(users, total)
UserCtl --> Page : Show the user list

Admin -> Page : Create a Content Manager or an Admin account
Page -> UserCtl : Create the user
UserCtl -> UserSvc : Create the user
UserSvc -> UserRepo : Save the new account\n(email, name, role, hashed password)
UserRepo -> DB : run the query
DB --> UserRepo : the matching rows
UserSvc -> Activity : Record the admin action
UserSvc --> UserCtl : UserItem(user)
UserCtl --> Page : Show the new account

Admin -> Page : Activate or deactivate some accounts
Page -> UserCtl : Change the status of the accounts
UserCtl -> UserSvc : Change the status of the accounts
UserSvc -> UserRepo : Update the status of the accounts
UserRepo -> DB : run the query
DB --> UserRepo : the matching rows
UserSvc -> Activity : Record the admin action
UserSvc --> UserCtl : BulkResult(updated, failed)
UserCtl --> Page : Show the result of the bulk update

== MANAGE THE MAINTENANCE WINDOWS ==

Admin -> Page : Create a maintenance window
Page -> MtCtl : Create the maintenance schedule
MtCtl -> MtSvc : Create the maintenance schedule
MtSvc -> SchedRepo : Save the maintenance schedule
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
SchedRepo --> MtSvc : the saved schedule
MtSvc --> MtCtl : MaintenanceScheduleResponseDto(schedule)
MtCtl --> Page : Show the new schedule

Admin -> Page : Start the maintenance window
Page -> MtCtl : Start the maintenance schedule
MtCtl -> MtSvc : Start the maintenance schedule
MtSvc -> LockSvc : Lock the affected areas of the platform
LockSvc --> MtSvc : the areas are locked
MtSvc -> SchedRepo : Mark the schedule as running
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
MtSvc --> MtCtl : MaintenanceScheduleResponseDto(schedule)
MtCtl --> Page : Show the running schedule

Admin -> Page : Complete or cancel the maintenance window
Page -> MtCtl : Complete / cancel the maintenance schedule
MtCtl -> MtSvc : Complete / cancel the maintenance schedule
MtSvc -> LockSvc : Release the locked areas
MtSvc -> SchedRepo : Mark the schedule as done or cancelled
SchedRepo -> DB : run the query
DB --> SchedRepo : the matching rows
MtSvc --> MtCtl : MaintenanceScheduleResponseDto(schedule)
MtCtl --> Page : Show the final status of the schedule

@enduml
