AiSupportSessionRepository ..|> JpaRepository : extends
AiSupportMessageRepository ..|> JpaRepository : extends
AiSupportUsageRepository ..|> JpaRepository : extends
FormRuleRepository ..|> JpaRepository : extends
ProgressionRuleRepository ..|> JpaRepository : extends
SessionExerciseResultRepository ..|> JpaRepository : extends
SessionSetResultRepository ..|> JpaRepository : extends
ExerciseRepository ..|> JpaRepository : extends
MemberProfileRepository ..|> JpaRepository : extends
MemberSkillProgressRepository ..|> JpaRepository : extends
UserRepository ..|> JpaRepository : extends
NotificationRepository ..|> JpaRepository : extends
MemberFavoriteRepository ..|> JpaRepository : extends
