' ASSOCIATION - DAO manages Entity
'==============================================================
AiSupportSessionRepository -- AiSupportSession
AiSupportMessageRepository -- AiSupportMessage
AiSupportUsageRepository -- AiSupportUsage
FormRuleRepository -- FormRule
ProgressionRuleRepository -- ProgressionRule
SessionExerciseResultRepository -- SessionExerciseResult
SessionSetResultRepository -- SessionSetResult
ExerciseRepository -- Exercise
MemberProfileRepository -- MemberProfile
MemberSkillProgressRepository -- MemberSkillProgress
UserRepository -- User
NotificationRepository -- Notification
MemberFavoriteRepository -- MemberFavorite
WorkoutRepository -- WorkoutEntry
ProfanityWordRepository -- ProfanityWord

'==============================================================
' AGGREGATION - entity foreign key
'==============================================================
AiSupportSession "0..*" o-- "1" User : owned by
AiSupportMessage "0..*" o-- "1" User : asked by
AiSupportMessage "0..*" o-- "1" Exercise : about
AiSupportUsage "0..*" o-- "1" User : consumed by
ProgressionRule "0..*" o-- "1" Exercise : unlocks
ProgressionRule "0..*" o-- "1" Exercise : requires
SessionExerciseResult "0..*" o-- "1" Exercise : performed
SessionSetResult "0..*" o-- "1" SessionExerciseResult : breaks down
FormRule "0..*" o-- "1" Exercise : corrects
MemberSkillProgress "0..*" o-- "1" Exercise : tracks
MemberSkillProgress "0..*" o-- "1" MemberProfile : owned by
MemberProfile "0..*" o-- "1" User : belongs to
MemberProfile "0..*" o-- "1" FitnessLevel : current tier
Exercise "0..*" o-- "1" User : written by

@enduml
