@startuml
'==============================================================
' DESIGN SET DS4 - AI Coaching and Exercise Progression
' Sequence: The member asks the AI coach a question
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS4 - Ask the AI coach a question\n(Sequence Diagram)

participant "Member" as Member
participant "AI Support Page\n(React)" as Page
participant "MemberAiSupportController" as Ctl
participant "AiSupportService" as Svc
participant "ContentModerationService" as ModSvc
participant "AiSupportUsageRepository" as UseRepo
participant "AiSupportSessionRepository" as SessRepo
participant "AiSupportMessageRepository" as MsgRepo
participant "AI Provider\n(OpenAI or Gemini)" as Provider
participant "MySQL\n(Database)" as DB

== ASK A QUESTION ==

Member -> Page : Type the question and send it
Page -> Ctl : Ask the AI coach (exercise code, question, session id)
Ctl -> Svc : Ask the AI coach
Svc -> ModSvc : Check the question for inappropriate language
ModSvc --> Svc : the flagged word or nothing

alt the question contains inappropriate language
  Svc --> Ctl : Reject the question\n(400 BAD_REQUEST "Please rephrase your question")
  Ctl --> Page : Show the error message in the chat
else the question is allowed
  Svc -> UseRepo : Lock the daily usage of the member
UseRepo -> DB : run the query
DB --> UseRepo : the matching rows
UseRepo --> Svc : the used question count of the day

  alt the daily quota is used up
    Svc --> Ctl : Reject the question\n(429 TOO_MANY_REQUESTS "The daily quota is used up")
    Ctl --> Page : Show the quota message in the chat
  else the daily quota is not used up
    Svc -> SessRepo : Lock the chat session of the member
SessRepo -> DB : run the query
DB --> SessRepo : the matching rows
SessRepo --> Svc : the used question count of the session

    alt the session quota is used up
      Svc --> Ctl : Reject the question\n(429 TOO_MANY_REQUESTS "The session quota is used up")
      Ctl --> Page : Show the quota message in the chat
    else the session quota is not used up
      Svc -> Provider : Send the question with the safety context
      Provider --> Svc : the answer of the AI coach
      Svc -> MsgRepo : Save the question and the answer
MsgRepo -> DB : run the query
DB --> MsgRepo : the matching rows
      Svc -> UseRepo : Increase the daily and the session counters
UseRepo -> DB : run the query
DB --> UseRepo : the matching rows
      Svc --> Ctl : AskQuestionResponse(answer)
      Ctl --> Page : Show the answer in the chat
    end
  end
end

== READ THE HISTORY AND THE QUOTA ==

Member -> Page : Open the chat history
Page -> Ctl : Get the history of the member
Ctl -> Svc : Get the history of the member
Svc -> MsgRepo : Load the saved messages
MsgRepo -> DB : run the query
DB --> MsgRepo : the matching rows
MsgRepo --> Svc : the message list
Svc --> Ctl : the history items
Ctl --> Page : Show the chat history

Member -> Page : Open the quota panel
Page -> Ctl : Get the quota of the member
Ctl -> Svc : Get the quota of the member
Svc -> UseRepo : Load the used question count
UseRepo -> DB : run the query
DB --> UseRepo : the matching rows
UseRepo --> Svc : the used count and the limits
Svc --> Ctl : QuotaResponse(used, daily limit, session limit)
Ctl --> Page : Show the remaining quota

@enduml
