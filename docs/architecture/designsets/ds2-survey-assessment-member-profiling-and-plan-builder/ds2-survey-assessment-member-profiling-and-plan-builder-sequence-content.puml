@startuml
'==============================================================
' DESIGN SET DS2 - Survey Assessment, Member Profiling and Plan Builder
' Sequence: Content Manager manages the survey steps and the daily plan templates
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS2 - Manage the survey steps and the plan templates\n(Sequence Diagram - Content Manager)

participant "Content Manager" as CM
participant "Survey Step Page\n(React)" as Page
participant "SurveyStepManagementController" as Ctl
participant "SurveyStepManagementService" as Svc
participant "SurveyConfigValidator" as Validator
participant "QuestionTypeRegistry" as Registry
participant "StepQuestionWriter" as Writer
participant "SurveyStepRepository" as StepRepo
participant "DailyPlanTemplateController" as PlanCtl
participant "DailyPlanTemplateService" as PlanSvc
participant "MySQL\n(Database)" as DB

== LIST AND CREATE A SURVEY STEP ==

CM -> Page : Open the survey step list of a survey
Page -> Ctl : List the steps of the survey
Ctl -> Svc : List the steps of the survey
Svc -> StepRepo : Load the steps of the survey
StepRepo -> DB : run the query
DB --> StepRepo : the matching rows
StepRepo --> Svc : the step list
Svc --> Ctl : the step list
Ctl --> Page : Show the step list

CM -> Page : Fill in a new step and save it
Page -> Ctl : Create the step (survey code, version, step request)
Ctl -> Svc : Create the step
Svc -> Validator : Check the step configuration
Validator --> Svc : the configuration is valid or not

alt the step configuration is not valid
  Svc --> Ctl : Reject the step\n(400 BAD_REQUEST with the reason)
  Ctl --> Page : Show the validation errors on the form
else the step configuration is valid
  Svc -> Registry : Resolve the question types of the step
  Svc -> Writer : Write the questions and the options of the step
  Svc -> StepRepo : Save the step with its questions
StepRepo -> DB : run the query
DB --> StepRepo : the matching rows
  Svc --> Ctl : The step has been created
  Ctl --> Page : Show the step detail and refresh the list
end

== CHANGE THE STATUS AND DELETE A STEP ==

CM -> Page : Publish, hide or delete a step
Page -> Ctl : Change the status of the step / delete the step
Ctl -> Svc : Change the status of the step / delete the step
Svc -> StepRepo : Update the status / remove the step
StepRepo -> DB : run the query
DB --> StepRepo : the matching rows
Svc --> Ctl : The step has been changed
Ctl --> Page : Show the result and refresh the list

== MANAGE THE DAILY PLAN TEMPLATES ==

CM -> Page : Open the daily plan template list
Page -> PlanCtl : List the plan templates
PlanCtl -> PlanSvc : List the plan templates
PlanSvc --> PlanCtl : the template list
PlanCtl --> Page : Show the template list

CM -> Page : Create a plan template or change its status
Page -> PlanCtl : Create the template / change the template status
PlanCtl -> PlanSvc : Create the template / change the template status
PlanSvc --> PlanCtl : The template has been saved
PlanCtl --> Page : Show the result and refresh the list

@enduml
