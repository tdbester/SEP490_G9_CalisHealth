'==============================================================
' DESIGN SET DS2 - Survey Assessment, Member Profiling & Plan Builder
' Class Diagram: Controller -> Service -> DTO -> DAO -> Entity
'
' Scope: onboarding survey definition and sessions, level assessment,
'        member profile and fitness profiling, training plan templates.
'
' UML notation - exactly the six symbols of the project reference:
'   --      Association            solid line, no head
'   --|>    Generalization          solid line, hollow triangle
'   ..|>    Realization             dashed line, hollow triangle
'   ..>     Dependency              dashed line, OPEN arrow head
'   o--     Aggregation             solid line, hollow diamond
'   *--     Composition             solid line, filled diamond
'==============================================================
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam arrowThickness 1.2
skinparam defaultLineThickness 1.2
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam nodesep 30
skinparam ranksep 45
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam class {
  BorderThickness 1.2
  BackgroundColor #FFFFFF
  FontColor #000000
  AttributeFontColor #1F3864
  MethodFontColor #7B3F00
}
skinparam package {
  BorderThickness 1.2
  FontStyle bold
  FontSize 11
  BackColor #E4E4E4
}
skinparam stereotype {
  FontSize 8
  FontStyle italic
}

title DESIGN SET DS2 - Survey Assessment, Member Profiling & Plan Builder\n(Class Diagram)

