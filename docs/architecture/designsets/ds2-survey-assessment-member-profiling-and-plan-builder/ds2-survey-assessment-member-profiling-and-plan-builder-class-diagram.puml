    - description : String
    - stepType : Type
    - resultConfig : String
    - sortOrder : int
    - status : Status
    - revision : int
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    - updatedBy : User <<FK>>
  }

  class SurveyStepQuestion <<Entity>> {
    - id : Long <<PK>>
    - step : SurveyStep <<FK>>
    - question : AssessmentQuestion <<FK>>
    - sortOrder : int
    - required : Boolean
    - conditionalRules : String
    - active : boolean
  }

  class AssessmentQuestion <<Entity>> {
    - id : Long <<PK>>
    - questionCode : String <<UK>>
    - questionText : String
    - description : String
    - questionType : String
    - required : boolean
    - validationRules : String
    - displayConfig : String
    - unit : String
    - defaultValue : String
    - status : ConfigStatus
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
  }

  class AssessmentOption <<Entity>> {
    - id : Long <<PK>>
    - question : AssessmentQuestion <<FK>>
    - optionCode : String
