@startuml
'==============================================================
' DESIGN SET DS1 - User Account Registration & Authentication
' Sequence: Sign in with email and password (Member / Content Manager / Admin)
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS1 - Sign in\n(Sequence Diagram)

participant "Member / Content Manager / Admin" as User
participant "Login Page\n(React)" as Page
participant "AuthController" as Ctl
participant "AuthService" as Svc
participant "UserRepository" as UserRepo
participant "JwtService" as Jwt
participant "SurveyController" as SurveyCtl
participant "MySQL\n(Database)" as DB

== SIGN IN ==

User -> Page : Fill in the sign-in form\n(email, password)
Page -> Page : Read the form values\n(email trimmed to lower case)
Page -> Ctl : Sign in the user
Ctl -> Svc : Sign in the user
Svc -> UserRepo : Look up the account by email address
UserRepo -> DB : run the query
DB --> UserRepo : the matching rows
UserRepo --> Svc : Optional<User>

alt the account or the password is wrong
  Svc --> Ctl : Reject the sign-in\n(401 UNAUTHORIZED "Incorrect email or password")
  Ctl --> Page : Show the error message on the form
else the account is blocked or the email is not verified
  Svc --> Ctl : Reject the sign-in\n(403 FORBIDDEN "Your account has been blocked" or "Account email is not verified")
  Ctl --> Page : Show the error message on the form
else the account may be used
  Svc -> Svc : Compare the typed password with the stored hash
  Svc -> Jwt : Create a signed access token for this user
  Jwt --> Svc : access token
  Svc --> Ctl : AuthResponse(token, email, fullName, role, mustChangePassword)
  Ctl --> Page : Store the token and the account in the browser
end

== THE ACCOUNT IS OPENED FOR THE RIGHT ROLE ==

alt the account still uses the default password
  Page --> User : Send the user to the change-password page
else the account is a Member
  Page -> SurveyCtl : Ask for the onboarding survey definition and sessions
  SurveyCtl --> Page : the survey definition and the session list

  alt the onboarding survey cannot be read
    Page --> User : Send the user to the member home page
  else the member has no session yet or the session is still IN_PROGRESS
    Page --> User : Send the member to the onboarding survey
  else the member has finished the survey or skipped it
    Page --> User : Send the member to the member home page
  end
else the account is a Content Manager
  Page --> User : Send the user to the content manager dashboard
else the account is an Admin
  Page --> User : Send the user to the admin dashboard
end

@enduml
