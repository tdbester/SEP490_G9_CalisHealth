@startuml
'==============================================================
' DESIGN SET DS1 - User Account Registration & Authentication
' Sequence: Forgot password and reset the password in one flow
'            (Member / Content Manager / Admin)
'==============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam ArrowFontSize 9
skinparam ArrowColor #333333
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 10
skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #777777
  ParticipantBorderColor #333333
  ParticipantBackgroundColor #FFFFFF
  ArrowFontSize 9
}
skinparam ParticipantPadding 12

'===============================================================
' Every layer is a rectangle with a single head at the top.
' The life lines get shorter from the left to the right.
'===============================================================
hide footbox
skinparam ParticipantBorderThickness 1.2
title DS1 - Forgot password and reset the password\n(Sequence Diagram)

participant "Member / Content Manager / Admin" as User
participant "Forgot Password Page\n(React)" as FogPage
participant "Reset Password Page\n(React)" as RstPage
participant "AuthController" as Ctl
participant "AuthService" as Svc
participant "UserRepository" as UserRepo
participant "TokenRepository" as TokenRepo
participant "EmailService" as Mail
participant "MySQL\n(Database)" as DB

== FORGOT PASSWORD AND RESET THE PASSWORD ==

User -> FogPage : Type my email address and submit
FogPage -> FogPage : Check the email format
alt the email format is not valid
  FogPage --> User : Show the inline validation message\nand keep the form open
else the email format is valid
  FogPage -> Ctl : Ask the server to send a reset link
  Ctl -> Svc : Send a password reset link
  Svc -> UserRepo : Look up the account by email address
  UserRepo -> DB : run the query
  DB --> UserRepo : the matching rows
  UserRepo --> Svc : Optional<User>

  alt there is no account with this email address
    Svc --> Ctl : Finish silently\n(never reveal whether the account exists)
    Ctl --> FogPage : Show the neutral success panel
  else the account is blocked or the email is not verified
    Svc --> Ctl : Reject the request\n(403 FORBIDDEN)
    Ctl --> FogPage : Show the error message on the form
  else the account may ask for a reset
    Svc -> TokenRepo : Remove any previous reset token of this user
    TokenRepo -> DB : run the query
    DB --> TokenRepo : the matching rows
    Svc -> TokenRepo : Save a new reset token valid for 30 minutes
    TokenRepo -> DB : run the query
    DB --> TokenRepo : the matching rows
    Svc -> Mail : Send the reset email\n"[CLH] Reset your password"
    Svc --> Ctl : The reset link has been sent
    Ctl --> FogPage : Show the neutral success panel
  end
end

User -> RstPage : Open the reset link from the inbox
RstPage -> Ctl : Check the reset token (token)
Ctl -> Svc : Check whether the reset token is usable
Svc -> TokenRepo : Find the token of type RESET_PASSWORD
TokenRepo -> DB : run the query
DB --> TokenRepo : the matching rows
TokenRepo --> Svc : the token may be unknown, used or expired

alt the token cannot be used
  Svc --> Ctl : Reject the request\n(400 BAD_REQUEST "The link is invalid or has expired")
  Ctl --> RstPage : Show the expired-link message\nand count down to the sign-in page
else the token is valid
  Svc --> Ctl : The reset token is valid
  Ctl --> RstPage : Show the valid-token message\nand count down to the new-password page

  User -> RstPage : Type the new password twice and submit
  RstPage -> RstPage : Check the form and re-check the token
  alt the form is not valid yet
    RstPage --> User : Show the inline validation messages\nand keep the form open
  else the form is valid
    RstPage -> Ctl : Reset password(token, new password, confirm new password)
    Ctl -> Svc : Reset the password of the user
    Svc -> UserRepo : Look up the account of the token
    UserRepo -> DB : run the query
    DB --> UserRepo : the matching rows

    alt the account is blocked or the email is not verified
      Svc -> TokenRepo : Delete the used reset token
      TokenRepo -> DB : run the query
      DB --> TokenRepo : the matching rows
      Svc --> Ctl : Reject the request\n(403 FORBIDDEN)
      Ctl --> RstPage : Show the error message\nand count down to the sign-in page
    else the account may be reset
      Svc -> Svc : Hash the new password
      Svc -> UserRepo : Save the account\n(new hash, mustChangePassword=false, passwordChangedAt=now)
      UserRepo -> DB : run the query
      DB --> UserRepo : the matching rows
      Svc -> TokenRepo : Delete the used reset token
      TokenRepo -> DB : run the query
      DB --> TokenRepo : the matching rows
      Svc --> Ctl : The password has been reset
      Ctl --> RstPage : Show the success panel\n"Password reset successfully!" and count down to the sign-in page
    end
  end
end

@enduml
