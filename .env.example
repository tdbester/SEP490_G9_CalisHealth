# Copy file này thành .env.local và điền giá trị thật
# Prefix VITE_ là bắt buộc để Vite expose ra frontend

# URL của backend Spring Boot
VITE_API_URL=http://localhost:8080/api

# --------------------------------------------------------------- AI Support
# OpenAI API key cho tính năng AI Support (popup hỏi AI ở /session/result).
#
# CÁCH DÙNG:
#   1. Copy file này thành file `.env` ở THƯ MỤC GỐC REPO (cùng cấp với
#      client/ và server/), điền OPENAI_API_KEY thật.
#   2. Backend tự đọc file .env đó (spring.config.import trong application.yml).
#      Không cần set biến môi trường thủ công.
#
# LƯU Ý: file `.env` đã được .gitignore — không bao giờ commit key lên Git.
OPENAI_API_KEY=

# Model dùng cho AI Support. gpt-4o-mini là rẻ nhất, đủ cho câu hỏi về form.
OPENAI_MODEL=gpt-4o-mini

# Base URL của OpenAI (đổi khi dùng proxy/Azure OpenAI).
OPENAI_BASE_URL=https://api.openai.com

# Timeout gọi API (giây).
OPENAI_TIMEOUT_SECONDS=45

# Chế độ demo: khi API lỗi (hết credit, mất mạng, rate limit) thì AI Support
# trả lời bằng rule nội bộ kèm cờ báo rõ cho member, thay vì báo lỗi.
# Đặt false khi đã nạp credit để member thấy lỗi thật.
OPENAI_DEMO_FALLBACK=true
