# Copy file này thành file `.env` ở THƯ MỤC GỐC REPO (cùng cấp với
# client/ và server/), điền key thật.
# Backend tự đọc file .env đó (spring.config.import trong application.yml) —
# không cần set biến môi trường thủ công.
#
# LƯU Ý: file `.env` đã được .gitignore — không bao giờ commit key lên Git.

# Prefix VITE_ là bắt buộc để Vite expose ra frontend
VITE_API_URL=http://localhost:8080/api

# --------------------------------------------------------------- Database
# MySQL local. Backend đọc file .env này (spring.config.import trong
# application.yml) — không cần set biến môi trường thủ công.
DB_USERNAME=root
DB_PASSWORD=

# --------------------------------------------------------------- JWT
# Khóa ký token đăng nhập. Tối thiểu 32 ký tự.
# Sinh bằng:  openssl rand -base64 48
JWT_SECRET=

# --------------------------------------------------------------- Cloudinary
# Lưu trữ media trên Cloudinary. Để trống CLOUDINARY_CLOUD_NAME thì backend
# lưu file upload cục bộ (đổi qua biến môi trường khác).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=calishealth
CLOUDINARY_OPTIMIZE_ENABLED=true

# --------------------------------------------------------------- SMTP (gửi mail)
# Dùng cho đặt lại mật khẩu và thông báo. Để trống thì tính năng gửi mail
# bị tắt (app vẫn chạy bình thường).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --------------------------------------------------------------- AI Support
# Nhà cung cấp AI cho popup hỏi AI ở /session/result.
#
#   "auto"   -> ưu tiên Gemini (free tier, không cần nạp credit),
#               fallback sang OpenAI nếu Gemini chưa có key.
#   "gemini" -> chỉ dùng Gemini.
#   "openai" -> chỉ dùng OpenAI (cần nạp credit mới chạy được).
AI_PROVIDER=auto

# ------------------------------------------------------------- Gemini (free)
# Lấy key MIỄN PHÍ tại https://aistudio.google.com/apikey
# -> "Create API key" -> copy chuỗi bắt đầu bằng "AIza...".
#
# Đây là lựa chọn mặc định vì free tier không yêu cầu thanh toán.
GEMINI_API_KEY=

# Model Gemini. gemini-3.5-flash nằm trong free tier.
GEMINI_MODEL=gemini-3.5-flash

# Base URL của Gemini API (đổi khi dùng proxy).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Timeout gọi API (giây).
GEMINI_TIMEOUT_SECONDS=45

# Ngân sách token cho câu trả lời của AI (JSON 3 nguyên nhân + mẹp sửa +
# 2 câu hỏi gợi ý). Tăng nếu prompt dài (nhiều form rule + hồ sơ sinh lý).
GEMINI_MAX_OUTPUT_TOKENS=1024

# Chế độ demo: khi API lỗi (hết quota, mất mạng) thì AI Support trả lời
# bằng rule nội bộ kèm cờ báo rõ cho member, thay vì báo lỗi.
GEMINI_DEMO_FALLBACK=true

# ------------------------------------------------------------- OpenAI (trả phí)
# OpenAI yêu cầu nạp credit mới gọi được API — xem
# https://platform.openai.com/settings/organization/billing/overview
OPENAI_API_KEY=

# Model dùng cho AI Support. gpt-4o-mini là rẻ nhất, đủ cho câu hỏi về form.
OPENAI_MODEL=gpt-4o-mini

# Base URL của OpenAI (đổi khi dùng proxy/Azure OpenAI).
OPENAI_BASE_URL=https://api.openai.com

# Timeout gọi API (giây).
OPENAI_TIMEOUT_SECONDS=45

# Ngân sách token cho câu trả lời của AI.
OPENAI_MAX_OUTPUT_TOKENS=700

# Chế độ demo: khi API lỗi (hết credit, mất mạng, rate limit) thì AI Support
# trả lời bằng rule nội bộ kèm cờ báo rõ cho member, thay vì báo lỗi.
# Đặt false khi đã nạp credit để member thấy lỗi thật.
OPENAI_DEMO_FALLBACK=true
